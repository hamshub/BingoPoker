# BingoPoker environment template
# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# ---------------------------------------------------------------------------
# App settings (read by backend/app.py when running locally with python)
# ---------------------------------------------------------------------------

# Bind address and port
HOST=0.0.0.0
PORT=8081

# "true" also mounts the destructive /api/debug endpoints. Keep False in production.
DEBUG=False

# Where users.json, rooms.json, analytics.json and .email_pepper are stored.
# Empty = backend/data. Relative paths resolve against the working directory.
DATA_DIR=

# Where the daily-rotated logs are written. Empty = backend/logs.
LOG_DIR=

# Secret used to hash emails. Empty = generated once into <DATA_DIR>/.email_pepper.
# Changing or losing it orphans every existing user.
EMAIL_HASH_PEPPER=

# Password for the /logs and /analytics pages (HTTP Basic auth, any username).
# Empty = those pages are disabled. Only use over HTTPS.
ADMIN_PASSWORD=

# APP_VERSION and BUILD_DATE are set by the Docker build; leave them unset locally.

# ---------------------------------------------------------------------------
# Docker / NAS (.env next to docker-compose.yml)
# ---------------------------------------------------------------------------
# docker compose passes every variable in that .env into the container, so set
# app settings such as ADMIN_PASSWORD there directly. HOST, PORT, DEBUG, DATA_DIR
# and LOG_DIR are fixed in docker-compose.yml and override any value here.
# A literal "$" in a value must be written as "$$".

# Image published by the GitHub Action: ghcr.io/<github-owner in lowercase>/bingopoker:latest
BINGOPOKER_IMAGE=ghcr.io/<github-owner>/bingopoker:latest
