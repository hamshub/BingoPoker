# Environment Configuration - Copy to .env and customize

# Server Configuration
HOST=0.0.0.0
PORT=8081
DEBUG=True

# Data Directory (relative to backend/app.py; leave unset to default to backend/data)
DATA_DIR=data

# Pepper used to hash user emails; leave unset to auto-generate backend/data/.email_pepper
# Changing or losing this value orphans all existing user records
EMAIL_HASH_PEPPER=
