# Environment Configuration - Copy to .env and customize

# Server Configuration
HOST=0.0.0.0
PORT=8081
DEBUG=True

# Data Directory (relative to backend/app.py; leave unset to default to backend/data)
DATA_DIR=data

# Application Settings
MAX_USERS_PER_ROOM=20
MAX_ROOM_NAME_LENGTH=100
MAX_USERNAME_LENGTH=50
MAX_CELL_TEXT_LENGTH=50
WEBSOCKET_TIMEOUT=30
